{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./credentials*.json)",
      "Bash(curl *api.line.me*)",
      "Bash(wget *api.line.me*)"
    ],
    "allow": [
      "Bash(python -m unittest discover -s tests -p 'test_*.py')",
      "Bash(python scripts/property_pipeline.py --input data/sample_properties.csv --output out --format all)",
      "Bash(cd cloudflare-worker && npm test)"
    ]
  }
}
